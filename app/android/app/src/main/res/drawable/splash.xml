<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen (Android 11 and older): the clay NX tile on the site's dark background -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/nx_background" />
    <item android:gravity="center" android:width="72dp" android:height="72dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ic_launcher_background" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <item android:drawable="@mipmap/ic_launcher_foreground" android:gravity="center" android:width="108dp" android:height="108dp" />
</layer-list>
